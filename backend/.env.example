# Server
PORT=5000
NODE_ENV=development

# SQL Server Express - SQL Server Authentication
# Sao chép file này thành .env và điền thông tin của bạn
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DaNangGo
DB_USER=your_db_user
DB_PASS=your_db_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Frontend URL (CORS & CSRF Protection)
FRONTEND_URL=http://localhost:3000

# Auth / Session configuration (dùng chuỗi ngẫu nhiên tối thiểu 32 ký tự)
# JWT_ACCESS_SECRET và JWT_SECRET có thể dùng chung hoặc riêng biệt (tối thiểu 32 ký tự)
JWT_SECRET=replace_with_the_shared_auth_secret_minimum_32_characters
JWT_ACCESS_SECRET=replace_with_the_shared_auth_secret_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_the_refresh_auth_secret_minimum_32_characters

# Seed admin (chỉ cần khi chạy npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_AVATAR_URL=
ADMIN_IS_DEFAULT_PASSWORD=false

# SePay Webhook (nạp tiền / đăng ký đối tác)
# Tạo token ngẫu nhiên bảo mật cao hoặc lấy từ trang cấu hình SePay
SEPAY_API_KEY=your_sepay_api_token_here

# (Tùy chọn) Mailer - Khôi phục mật khẩu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="DaNangGo" <noreply@dananggo.vn>

# ─────────────────────────────────────────────────────────────────────────────
# Gemini AI (DanangGo AI Assistant)
# Tạo key tại: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=15000

# Embedding cho gợi ý tương tự (chỉ backend; đồng bộ từ /admin/ai)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
