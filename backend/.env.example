PORT=5000

NODE_ENV=development

DB_SERVER=localhost

DB_PORT=1433

DB_NAME=DaNangGo

DB_USER=your_db_user

DB_PASS=your_db_password

DB_ENCRYPT=false

DB_TRUST_SERVER_CERT=true

# Seed admin (required only when running npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Auth/session configuration (use separate random secrets of at least 32 bytes)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:3000

# SePay bank transfer display (public account details; never put the webhook secret in the frontend)
SEPAY_BANK_NAME=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_ACCOUNT_HOLDER=
SEPAY_BANK_BRANCH=

# Create an HMAC-SHA256 webhook in the SePay dashboard and store its Secret Key here.
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_MAX_AGE_SECONDS=300

# Optional SMTP. In development without SMTP, reset links are printed to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Gmail OTP (dùng cho xác thực email khi đăng ký)
# Hướng dẫn lấy App Password:
#   1. Bật 2-Step Verification tại https://myaccount.google.com/security
#   2. Vào https://myaccount.google.com/apppasswords
#   3. Chọn ứng dụng "Mail", thiết bị "Other", đặt tên "DaNangGo"
#   4. Copy mã 16 ký tự (không có khoảng trắng) vào MAIL_APP_PASSWORD
# Trong development nếu không cấu hình → mã OTP in ra backend console
# ─────────────────────────────────────────────────────────────────────────────
MAIL_USER=your_email@gmail.com
MAIL_APP_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=DaNangGo
