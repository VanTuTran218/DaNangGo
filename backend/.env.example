# Server
PORT=5000
NODE_ENV=development

# SQL Server Express - SQL Server Authentication
# Sao chép file này thành .env và điền thông tin của bạn
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DaNangGo
DB_USER=danangogo_app
DB_PASS=123456
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Frontend URL (CORS & CSRF Protection)
FRONTEND_URL=http://localhost:3000

# Auth / Session configuration (dùng chuỗi ngẫu nhiên tối thiểu 32 ký tự)
# JWT_ACCESS_SECRET và JWT_SECRET có thể dùng chung hoặc riêng biệt (tối thiểu 32 ký tự)
JWT_SECRET=replace_with_the_shared_auth_secret_minimum_32_characters
JWT_ACCESS_SECRET=replace_with_the_shared_auth_secret_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_the_refresh_auth_secret_minimum_32_characters

# Seed admin (chỉ cần khi chạy npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Cấu hình SMTP (tùy chọn; trong môi trường dev link reset mật khẩu sẽ in ra console)

# SePay bank transfer display (public account details; never put the webhook secret in the frontend)
SEPAY_BANK_NAME=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_ACCOUNT_HOLDER=
SEPAY_BANK_BRANCH=

# Create an HMAC-SHA256 webhook in the SePay dashboard and store its Secret Key here.
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_MAX_AGE_SECONDS=300

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Gmail OTP (dùng cho xác thực email khi đăng ký)
# Hướng dẫn lấy App Password:
#   1. Bật 2-Step Verification tại https://myaccount.google.com/security
#   2. Vào https://myaccount.google.com/apppasswords
#   3. Chọn ứng dụng "Mail", thiết bị "Other", đặt tên "DaNangGo"
#   4. Copy mã 16 ký tự (không có khoảng trắng) vào MAIL_APP_PASSWORD
# Trong development nếu không cấu hình → mã OTP in ra backend console
# ─────────────────────────────────────────────────────────────────────────────
MAIL_USER=your_gmail@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=DaNangGo
