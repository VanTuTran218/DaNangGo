PORT=5000

NODE_ENV=development

DB_SERVER=localhost

DB_PORT=1433

DB_NAME=DaNangGo

DB_USER=danangogo_app

DB_PASS=123456

DB_ENCRYPT=false

DB_TRUST_SERVER_CERT=true

# Seed admin (required only when running npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Auth/session configuration (use separate random secrets of at least 32 bytes)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:3000

# Optional SMTP. In development without SMTP, reset links are printed to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
